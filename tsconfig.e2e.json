{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "@playwright/test"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "src/test/diagnostics.ts",
    "src/vite-env.d.ts"
  ]
}
