{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "interior-magic-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Non-secret deployment allowlist. Replace only for a controlled deployment.
  "vars": {
    "ALLOWED_ORIGIN": "https://example.invalid",
    "TELEGRAM_INIT_DATA_MAX_AGE_SECONDS": "86400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "interior-magic-app",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": false
  }
}
