{
  "name": "interior-magic",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ithappy": "node scripts/run-ithappy-preview.mjs",
    "assets:r2:dry-run": "node scripts/ithappy-r2-delivery.mjs --release v1",
    "assets:r2:setup": "node scripts/setup-ithappy-r2.mjs interiormagic-assets",
    "assets:r2:deploy": "node scripts/ithappy-r2-delivery.mjs --release v1 --upload",
    "assets:r2:verify": "node scripts/ithappy-r2-delivery.mjs --release v1 --verify",
    "assets:r2:preview-placement": "node scripts/ithappy-preview-placement.mjs",
    "assets:r2:preview-placement:upload": "node scripts/ithappy-preview-placement.mjs --upload --verify",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --pretty false",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:registry:ithappy:local": "node scripts/run-ithappy-registry-local.mjs",
    "test:registry:ithappy:remote-local": "node scripts/run-ithappy-remote-local.mjs",
    "test:registry:ithappy:remote": "node scripts/run-ithappy-remote-local.mjs",
    "test:registry:ithappy:preview-disabled": "node scripts/run-ithappy-preview-disabled.mjs",
    "test:registry:ithappy:preview-production": "node scripts/run-ithappy-production-preview.mjs",
    "playwright:install": "playwright install chromium",
    "assets:generate": "node scripts/generate-fixture-glbs.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "camera-controls": "^3.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
